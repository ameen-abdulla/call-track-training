# ==============================================================================
# CALL TRACK — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to `.env` for local development or configure these variables
# in your hosting dashboard (Coolify, Railway, Docker, VPS).
#
# IMPORTANT PRODUCTION NOTICE:
# When deploying to production (https://calltrack.flexibook.ai), ensure that
# AUTH_URL and NEXTAUTH_URL are NOT set to localhost. Leaving localhost in
# production causes redirect loops, origin mismatches, and unauthenticated bounces.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# SQLite database file path.
# - Local development: "file:./dev.db"
# - Production Docker: "file:/data/dev.db" (persistent volume mounted at /data)
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION SECRETS (NextAuth v5 / Auth.js)
# ------------------------------------------------------------------------------
# Secret key used to encrypt session tokens and sign JWTs. Must be >= 32 characters.
# Generate a secure secret using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or using OpenSSL:
#   openssl rand -base64 32
#
# Set both AUTH_SECRET and NEXTAUTH_SECRET to the same generated value.
AUTH_SECRET="generate-a-real-random-64-char-hex-string"
NEXTAUTH_SECRET="generate-a-real-random-64-char-hex-string"

# ------------------------------------------------------------------------------
# 3. CANONICAL APP & AUTH URLS
# ------------------------------------------------------------------------------
# The canonical public base URL where your application is accessible.
#
# - Local development: "http://localhost:3000" (or http://localhost:4000)
# - Production deployment: MUST be set to "https://calltrack.flexibook.ai"
#
# ⚠️ CRITICAL: DO NOT set to "http://localhost:..." in production!
# Auth.js uses this URL to construct callbacks, validate origins, and issue redirects.
# If set to localhost in production, all browser redirects will point to localhost.
AUTH_URL="https://calltrack.flexibook.ai"
NEXTAUTH_URL="https://calltrack.flexibook.ai"

# ------------------------------------------------------------------------------
# 4. REVERSE PROXY & HOST TRUST
# ------------------------------------------------------------------------------
# When deployed behind a reverse proxy (Cloudflare, Nginx, Coolify/Traefik, Caddy),
# this MUST be set to true. It instructs Auth.js to trust forwarded headers:
#   - X-Forwarded-Host: calltrack.flexibook.ai
#   - X-Forwarded-Proto: https
#   - X-Forwarded-For: <client-ip>
# Without this, NextAuth will reject requests with an "UntrustedHost" error.
AUTH_TRUST_HOST=true

# ------------------------------------------------------------------------------
# 5. SERVER RUNTIME SETTINGS (Optional / Docker Defaults)
# ------------------------------------------------------------------------------
# PORT=3000
# HOSTNAME=0.0.0.0
# NODE_ENV=production

# ------------------------------------------------------------------------------
# 6. AUTOMATED BACKUPS (Optional)
# ------------------------------------------------------------------------------
# Cron expression for automated SQLite WAL-safe backups (default: 2:00 AM daily)
# BACKUP_CRON_SCHEDULE="0 2 * * *"
