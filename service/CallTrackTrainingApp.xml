<service>
  <id>CallTrackTrainingApp</id>
  <name>Call Track Training Application</name>
  <description>Call Track Tele-Calling Training Ops Center - Node.js Standalone Service</description>
  <executable>%BASE%\..\runtime\node.exe</executable>
  <arguments>%BASE%\..\app\run-server.js</arguments>
  <workingdirectory>%BASE%\..\app</workingdirectory>
  <logpath>C:\ProgramData\CallTrackTraining\logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10240</sizeThreshold>
    <pattern>yyyy-MM-dd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <startmode>Automatic</startmode>
  <delayedAutoStart>false</delayedAutoStart>
</service>
